# ===========================================
# OpenCode Zen Gateway - Configuration
# ===========================================
# Copy this file to .env and fill in the required values:
#   cp .env.example .env


# ===========================================
# REQUIRED
# ===========================================

# Your OpenCode API key (get one at https://opencode.ai)
OPENCODE_API_KEY="your_actual_opencode_api_key_here"

# Password protecting YOUR gateway. Clients must send this as their API key
# (Anthropic clients: x-api-key header; OpenAI clients: Authorization: Bearer).
PROXY_API_KEY="my-super-secret-password-123"


# ===========================================
# Upstream API
# ===========================================

# OpenCode Zen API base URL (rarely needs changing)
#OPENCODE_BASE_URL="https://opencode.ai/zen/v1"


# ===========================================
# Server
# ===========================================

# Host/port the gateway listens on.
# Priority: CLI args (--host/--port) > these env vars > defaults (0.0.0.0:8000)
#SERVER_HOST="0.0.0.0"
#SERVER_PORT="8000"

# Route upstream traffic through an HTTP proxy (e.g. for VPN setups).
# localhost is automatically excluded.
#VPN_PROXY_URL="http://127.0.0.1:7890"


# ===========================================
# Timeouts & Retries
# ===========================================

# Max seconds to wait for the FIRST byte of the upstream response
#FIRST_TOKEN_TIMEOUT="15"

# Retries when the first token times out (streaming requests)
#FIRST_TOKEN_MAX_RETRIES="3"

# Max seconds between chunks once the stream has started
#STREAMING_READ_TIMEOUT="300"


# ===========================================
# Features
# ===========================================

# Truncation recovery: informs the model when the upstream silently truncated
# a tool result, preventing infinite retry loops (default: true)
#TRUNCATION_RECOVERY="true"

# Offer a web_search function tool to the model on every request (default: false).
# OPT-IN: the model's web_search tool call is returned to the CLIENT for
# execution; clients that don't implement it (e.g. Claude Code) will reject it.
#WEB_SEARCH_ENABLED="false"

# Tool descriptions longer than this are moved into the system prompt
# (the upstream rejects overly long tool descriptions)
#TOOL_DESCRIPTION_MAX_LENGTH="10000"

# Upstream payload size limit in bytes, and whether to auto-trim history to fit
#OPENCODE_ZEN_MAX_PAYLOAD_BYTES="600000"
#AUTO_TRIM_PAYLOAD="false"


# ===========================================
# Fake Reasoning (extended thinking emulation)
# ===========================================

# The upstream has no native extended-thinking API; when enabled the gateway
# injects <thinking> instructions and parses the tags back out of the response.
#FAKE_REASONING="false"

# Default thinking token budget, and the hard cap on client-requested budgets
# (fake reasoning consumes OUTPUT tokens, so the cap prevents the model from
# spending its whole allowance on thinking)
#FAKE_REASONING_MAX_TOKENS="4000"
#FAKE_REASONING_BUDGET_CAP="10000"

# What to do with parsed thinking content:
#   as_reasoning_content - expose as reasoning_content field (recommended)
#   remove               - drop thinking, return only the final answer
#   pass                 - pass through with original tags in content
#   strip_tags           - remove tags but keep thinking text in content
#FAKE_REASONING_HANDLING="as_reasoning_content"

# Chars to buffer at stream start while detecting an opening thinking tag
#FAKE_REASONING_INITIAL_BUFFER_SIZE="20"


# ===========================================
# Logging & Debug
# ===========================================

# Log level: TRACE, DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL="INFO"

# Debug request logging:
#   off    - disabled (default)
#   errors - buffer in memory, write to disk only when a request fails
#   all    - write every request (wipes the debug dir each request!)
#DEBUG_MODE="off"

# Directory for debug logs
#DEBUG_DIR="debug_logs"
